# Expo inlines EXPO_PUBLIC_* vars into the JS bundle at build time — there's
# no server/client split on a mobile app, so unlike the dashboard's
# BACKEND_API_URL (server-only), this one really is public once built.
# For a physical device or the Android emulator, "localhost" won't reach
# your dev machine — use your machine's LAN IP instead (Android emulator's
# special alias for the host machine is 10.0.2.2).
EXPO_PUBLIC_BACKEND_API_URL=http://localhost:3000/api/v1
