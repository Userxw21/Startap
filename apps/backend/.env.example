# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Database ---
# Owner role — used only by the migration CLI (data-source.ts). Has DDL rights
# and therefore bypasses Row-Level Security, so the running app must NOT use it.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=courier
DB_PASSWORD=courier_dev_password
DB_NAME=courier_platform

# Restricted role — used by the running NestJS app (see app.module.ts). Created
# by docker/init-db.sql. This is the connection RLS policies actually apply to.
DB_APP_USERNAME=courier_app
DB_APP_PASSWORD=courier_app_dev_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_dev_only_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGE_ME_dev_only_refresh_secret
JWT_REFRESH_TTL=30d

# --- i18n ---
DEFAULT_LOCALE=uz
