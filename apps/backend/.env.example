# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Comma-separated dashboard origin(s), e.g. https://app.example.com. Left
# unset here (dev is permissive — see main.ts), but main.ts refuses to boot
# in production without this set explicitly rather than defaulting to
# wide-open CORS.
CORS_ORIGIN=

# --- Database ---
# Owner role — used only by the migration CLI (data-source.ts). Has DDL rights
# and therefore bypasses Row-Level Security, so the running app must NOT use it.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=courier
DB_PASSWORD=courier_dev_password
DB_NAME=courier_platform

# Most managed Postgres providers (Render, Railway, Supabase, Neon, RDS)
# require this to be "true" — a plain connection is rejected outright.
DB_SSL=false

# Restricted role — used by the running NestJS app (see app.module.ts). Created
# by docker/init-db.sql. This is the connection RLS policies actually apply to.
DB_APP_USERNAME=courier_app
DB_APP_PASSWORD=courier_app_dev_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_dev_only_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGE_ME_dev_only_refresh_secret
JWT_REFRESH_TTL=30d

# --- i18n ---
DEFAULT_LOCALE=uz

# --- SMS (courier forgot-password) ---
# Sign up yourself at https://eskiz.uz — not something this codebase can do
# for you (account creation, payment). Left unset, forgot-password codes
# are logged to the server console instead of texted — see
# src/sms/sms.service.ts's ConsoleSmsSender. Fine for developing/testing
# the whole flow without a real SMS account.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Optional — defaults to Eskiz's shared test sender ID ("4546") if unset.
# A custom nickname needs approval from Eskiz first.
ESKIZ_SENDER_NICKNAME=
