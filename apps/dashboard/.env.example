# Server-side only — never exposed to the browser (no NEXT_PUBLIC_ prefix).
# All REST calls happen in Server Components / Server Actions / Route
# Handlers, never from client-side JS, so the API base URL and the auth
# tokens themselves never need to reach the browser's JS runtime for those.
BACKEND_API_URL=http://localhost:3000/api/v1

# The one deliberate exception to the rule above: a live WebSocket connection
# is inherently client-side (the browser holds it open directly), so it
# needs to know where to connect on its own — NEXT_PUBLIC_ is required here.
# See app/api/realtime-token/route.ts and components/RealtimeProvider.tsx
# for how the access token itself reaches the browser for the handshake,
# and the tradeoff that involves (documented there, not hidden).
NEXT_PUBLIC_BACKEND_WS_URL=http://localhost:3000

# Another deliberate exception: the live courier map (app/(dashboard)/map)
# renders the Google Maps JS SDK directly in the browser, so it needs its
# own key client-side — there's no way around that for a map widget.
# Get one at https://console.cloud.google.com/google/maps-apis — enable
# "Maps JavaScript API", create an API key, and (recommended) restrict it
# to your dashboard's domain(s) under "Application restrictions". Leaving
# this unset is fine: components/MapView.tsx detects a missing key and
# shows a placeholder instead of a broken map, it doesn't crash the page.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
